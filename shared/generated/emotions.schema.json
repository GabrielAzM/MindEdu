{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "emotions.schema.json",
  "type": "object",
  "definitions": {
    "checkin_create": {
      "type": "object",
      "required": ["emotion", "intensity", "context_tags", "need_tags"],
      "additionalProperties": false,
      "properties": {
        "emotion": { "type": "string", "enum": ["alegria", "tristeza", "raiva", "medo", "ansiedade", "frustracao", "calma", "orgulho", "confusao"] },
        "intensity": { "type": "integer", "minimum": 1, "maximum": 5 },
        "context_tags": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 32 } },
        "need_tags": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "enum": ["escuta", "ideias_praticas", "motivacao", "acalmar", "organizar_passos"] } }
      }
    }
  }
}
